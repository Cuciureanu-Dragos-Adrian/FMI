generareM = function(i, j)
{
return (1 / sqrt( (i+2) (j+2) ))
}
generareN = function(i, j)
{
return( (i+1) / (j+1) )
}
i = 1:15
j = 1:15
matriceaM = outer(i, j, generareM)
matriceaN = outer(i, j, generareN)
