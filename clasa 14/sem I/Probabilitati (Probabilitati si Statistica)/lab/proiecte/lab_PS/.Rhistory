v <- rnorm(100, mean = 1, sd = 0.3)
print(v)
mean_v = mean(v)
print(mean_v)
median_v = median(v)
print(median_v)
getmode <- function(v)
{
uniqv <- unique(v)
uniqv[which.max(tabulate(match(v, uniqv)))]
}
mode_v = getmode(v)
print(mode_v)
#subpunctul b
# Give the chart file a name.
png(file = "histogram.png")
# Create the histogram.
hist(v, xlab = "Value", col = "yellow", border = "black")
# Save the file.
dev.off()
